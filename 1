cmake_minimum_required(VERSION 3.10)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
project(FlappyBird C)

set(C_MAKE_STANDARD 11)

include(FetchContent)

#SDL2 is too old to pipewire lol, why didn't I used SDL3?
set(SDL_PIPEWIRE OFF CACHE BOOL "" FORCE)

#SDL2
FetchContent_Declare(
  SDL2
  GIT_REPOSITORY https://github.com/libsdl-org/SDL.git
  GIT_TAG release-2.32.2
  GIT_SHALLOW TRUE
)

#SDL2 IMAGE
set(SDL2IMAGE_INSTALL OFF)
FetchContent_Declare(
  SDL2_image
  GIT_REPOSITORY https://github.com/libsdl-org/SDL_image.git
  GIT_TAG release-2.8.2
  GIT_SHALLOW TRUE
)

#SDL2 TTF
set(SDL2TTF_Install OFF)
FetchContent_Declare(
  SDL2_ttf
  GIT_REPOSITORY https://github.com/libsdl-org/SDL_ttf.git
  GIT_TAG release-2.22.0
  GIT_SHALLOW TRUE
)

FetchContent_MakeAvailable(SDL2 SDL2_image SDL2_ttf)

file(GLOB SOURCES CONFIGURE_DEPENDS "src/*.c" "include/functions/*.c")

add_executable(flappy ${SOURCES})

target_link_libraries(flappy PRIVATE
  SDL2::SDL2
  SDL2::SDL2main
  SDL2_image::SDL2_image
  SDL2_ttf::SDL2_ttf
)

if(WIN32)
  add_custom_command(TARGET flappy POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_if_different
    $<TARGET_FILE:SDL2::SDL2>
    $<TARGET_FILE:SDL2_image::SDL2_image>
    $<TARGET_FILE:SDL2_ttf::SDL2_ttf>
    $<TARGET_FILE_DIR:flappy>
  )
endif()
